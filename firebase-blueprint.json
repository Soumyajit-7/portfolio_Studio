{
  "entities": {
    "Inquiry": {
      "title": "Inquiry",
      "description": "Incoming project inquiry or contact message submitted by a visitor.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "senderEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 150
        },
        "company": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "topic": {
          "type": "string",
          "enum": [
            "Freelance Project",
            "Working Student Role",
            "AI & Data Consulting",
            "General Inquiry"
          ],
          "maxLength": 60
        },
        "message": {
          "type": "string",
          "minLength": 5,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["new", "reviewed", "replied", "archived"],
          "maxLength": 20
        },
        "adminNotes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "sentViaGmail": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "senderName",
        "senderEmail",
        "company",
        "topic",
        "message",
        "status",
        "adminNotes",
        "sentViaGmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Scheduled consultation, Google Meet, or in-person appointment booking.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "clientEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 150
        },
        "meetingType": {
          "type": "string",
          "enum": [
            "Freelance Discovery",
            "Applied AI Consulting",
            "Working Student Interview",
            "Technical Mentorship"
          ],
          "maxLength": 60
        },
        "meetingMode": {
          "type": "string",
          "enum": ["google_meet", "in_person"],
          "maxLength": 20
        },
        "meetingPlace": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "timeSlot": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30
        },
        "timezone": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["pending", "counter_proposed", "confirmed", "completed", "cancelled"],
          "maxLength": 20
        },
        "meetLink": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "calendarEventId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "counterDate": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10
        },
        "counterTimeSlot": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "counterPlace": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "counterNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "clientName",
        "clientEmail",
        "meetingType",
        "meetingMode",
        "meetingPlace",
        "date",
        "timeSlot",
        "timezone",
        "notes",
        "status",
        "meetLink",
        "calendarEventId",
        "counterDate",
        "counterTimeSlot",
        "counterPlace",
        "counterNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "SocialUpdate": {
      "title": "SocialUpdate",
      "description": "Public portfolio update synced or published from Instagram or LinkedIn.",
      "type": "object",
      "properties": {
        "platform": {
          "type": "string",
          "enum": ["instagram", "linkedin"],
          "maxLength": 20
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "dateLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "externalUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "platform",
        "title",
        "caption",
        "dateLabel",
        "externalUrl",
        "category",
        "authorUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized portfolio administrator record.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "/inquiries/{inquiryId}": {
      "schema": {
        "$ref": "#/entities/Inquiry"
      },
      "description": "Visitor inquiries and freelance project leads."
    },
    "/appointments/{appointmentId}": {
      "schema": {
        "$ref": "#/entities/Appointment"
      },
      "description": "Scheduled consultation appointments."
    },
    "/social_updates/{updateId}": {
      "schema": {
        "$ref": "#/entities/SocialUpdate"
      },
      "description": "Public Instagram and LinkedIn activity highlights."
    },
    "/admins/{uid}": {
      "schema": {
        "$ref": "#/entities/AdminUser"
      },
      "description": "Portfolio admin role registry."
    }
  }
}
